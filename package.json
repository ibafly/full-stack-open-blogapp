{
  "name": "blog-list",
  "version": "0.1.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier \"**/*.{css,js,json,jsx,ts,tsx}\"",
    "format:write": "prettier --write \"**/*.{css,js,json,jsx,ts,tsx}\"",
    "start-old": "cross-env NODE_ENV=production node index.js",
    "dev-old": "cross-env NODE_ENV=development nodemon index.js",
    "build-old": "webpack --mode=production",
    "lint-old": "eslint --color --ext .js,.jsx .",
    "lint:fix": "pnpm lint -- --fix",
    "deploy": "git push heroku main",
    "logs:prod": "heroku logs --tail",
    "start:test": "cross-env NODE_ENV=test node index.js",
    "test": "cross-env NODE_ENV=test jest --verbose --runInBand",
    "test:e2e": "cypress run",
    "cypress:open": "cypress open",
    "mock-server": "json-server -p3001 db.json",
    "prepare": "husky install"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-form": "^0.1.3",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@types/node": "18.11.18",
    "@types/react": "18.2.24",
    "@types/react-dom": "18.2.8",
    "@vercel/analytics": "^0.1.11",
    "@vercel/og": "^0.0.26",
    "classnames": "^2.3.2",
    "clsx": "^2.0.0",
    "eslint-config-next": "13.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^4.17.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.2",
    "mongoose": "^8.13.2",
    "mongoose-unique-validator": "^4.0.1",
    "path-to-regexp": "8.2.0",
    "prop-types": "^15.8.0",
    "focus-trap-react": "^10.2.2",
    "framer-motion": "^8.5.5",
    "lucide-react": "0.105.0-alpha.4",
    "ms": "^2.1.3",
    "next": "14.3.0-canary.57",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-scripts": "5.0.1",
    "react-markdown": "^8.0.7",
    "tailwind-merge": "^1.14.0",
    "typescript": "5.2.2",
    "use-debounce": "^9.0.4",
    "vaul": "^0.6.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.6",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.10",
    "@types/ms": "^0.7.32",
    "autoprefixer": "^10.4.16",
    "concurrently": "^7.6.0",
    "postcss": "^8.4.31",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "tailwindcss": "^3.3.3",
    "@babel/core": "^7.26.10",
    "@babel/eslint-plugin": "^7.17.7",
    "@babel/preset-env": "^7.26.9",
    "babel-loader": "^10.0.0",
    "chokidar": "^4.0.3",
    "core-js": "3",
    "cypress": "^14.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^4.2.1",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-react": "^7.37.5",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^9.1.7",
    "lodash": "^4.17.21",
    "nodemon": "^3.1.9",
    "react-error-overlay": "^6.0.10",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.49.11",
    "sass-loader": "^16.0.5",
    "supertest": "^7.1.0",
    "webpack": "^5.71.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-dev-server": "^5.2.1",
    "webpack-hot-middleware": "^2.25.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "core-js-pure"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "dist/*",
      "client/*",
      "server/*"
    ]
  },
  "_moduleAliases": {
    "@root": ".",
    "@controllers": "server/controllers",
    "@models": "server/models",
    "@utils": "server/utils"
  }
}